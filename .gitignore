# Build output
bin/

# Go
go/vendor/

# Embedded engine (build artifact — only .gitkeep is tracked)
go/internal/embedded/engine/*
!go/internal/embedded/engine/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
python/vendor/
.venv/
venv/

# Testing
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Claude Code
.claude/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Fendix runtime
.fendix/

# Framework parity gate (make parity): venv and per-run results. The
# binary it builds, bin/fendix-parity, is covered by bin/ above.
.venv-parity/
.parity/
.parity-nosemgrep/

# Benchmark run artifacts (per-run timestamped dirs)
bench-results/

# FP-corpus raw scan outputs (per-run timestamped dirs); the curated
# catalog is at tasks/FP_CORPUS.md.
fp-corpus-results/

# v0.20 benchmark suite (internal/benchmark). The committed baseline and
# ground-truth lists ARE tracked; downloaded corpora and per-run results
# are not.
benchmarks/results/*
!benchmarks/results/.gitkeep
benchmarks/targets/owasp/
# Real-world benchmark seed-tier local path map (private, author machine only)
benchmarks/realworld/local.yaml

# v0.20 metrics (internal/metrics). Opt-in, local-only telemetry — never
# committed. Only the .gitkeep keeps the dir.
metrics/*.jsonl
metrics/*.jsonl.1

# Environment / secrets
.env
.env.*
*.pem
*.key
# Allow .env fixture files used by tests (TASK-085 .env-detection regression)
!python/tests/fixtures/**/.env
!python/tests/fixtures/**/.env.*

# Archives
*.zip
scripts/heavy-eval/corpus-cache/

.remember
# Compiled test artifacts accidentally committed under heavy-eval labels (v0.27 B5)
scripts/heavy-eval/labels/**/vulnerable-test

# Local worktrees for isolated feature work (superpowers:using-git-worktrees)
.worktrees/
