{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Fendix-app/Fendix/blob/main/docs/schema.json",
  "title": "FendixJSONReport",
  "description": "Schema for Fendix scan output produced by `fendix scan --format json`. Current reports carry metadata.schema_version 2. Additive fields do not require a version bump; incompatible shape or semantic changes do. Archived pre-versioned and schema-version 1 reports remain readable. See docs/schema.md.",
  "type": "object",
  "required": ["metadata", "summary", "sources", "total", "findings"],
  "additionalProperties": false,
  "properties": {
    "metadata": { "$ref": "#/definitions/ScanMetadata" },
    "summary":  { "$ref": "#/definitions/SeverityCounts" },
    "sources":  { "$ref": "#/definitions/SourceCounts" },
    "total":    { "type": "integer", "minimum": 0 },
    "decisions": { "$ref": "#/definitions/StatusCounts" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/Finding" }
    }
  },
  "definitions": {
    "ScanMetadata": {
      "type": "object",
      "required": ["target", "started_at", "duration", "version", "mode", "endpoints_scanned", "active_probes"],
      "additionalProperties": false,
      "properties": {
        "schema_version":    { "type": "integer", "minimum": 1 },
        "fingerprint_algorithm": { "type": "string" },
        "imports":           { "type": "array", "items": { "$ref": "#/definitions/ImportedTool" } },
        "target":            { "type": "string" },
        "started_at":        { "type": "string", "format": "date-time" },
        "duration":          { "type": "string" },
        "version":           { "type": "string" },
        "mode":              { "type": "string", "enum": ["blackbox", "whitebox", "hybrid", "import"] },
        "endpoints_scanned": { "type": "integer", "minimum": 0 },
        "endpoints_discovered": { "type": "integer", "minimum": 0 },
        "endpoints_truncated":  { "type": "boolean" },
        "active_probes":     { "type": "boolean" },
        "checks_run":        { "type": "array", "items": { "type": "string" } },
        "scanner_status":    { "type": "array", "items": { "$ref": "#/definitions/ScannerStatus" } },
        "coverage":          { "$ref": "#/definitions/Coverage" },
        "policy_version":    { "type": "string" },
        "release_decision":  { "type": "string", "enum": ["pass", "warn", "block", "incomplete"] },
        "coverage_state":    { "type": "string", "enum": ["complete", "incomplete", "unknown"] },
        "decision_policy_version": { "type": "string" },
        "decision_rationale": { "type": "object" }
      }
    },
    "ScannerStatus": {
      "type": "object",
      "required": ["name", "state"],
      "additionalProperties": false,
      "properties": {
        "name":     { "type": "string" },
        "state":    { "type": "string", "enum": ["ok", "skipped", "failed"] },
        "reason":   { "type": "string", "enum": ["not_applicable", "diff_unchanged", "disabled_by_flag", "disabled_offline", "dependency_missing", "unsupported_target", "network_error", "timeout", "execution_error", "malformed_output", "truncated_output", "input_error", "no_endpoints"] },
        "detail":   { "type": "string" },
        "attempts": { "type": "integer", "minimum": 2 }
      }
    },
    "Coverage": {
      "type": "object",
      "required": ["contract_version", "strict", "configured_complete", "gaps", "limitations", "required_analyzers", "required_gaps", "retried"],
      "additionalProperties": false,
      "properties": {
        "contract_version":    { "type": "integer", "minimum": 1 },
        "strict":              { "type": "boolean" },
        "configured_complete": { "type": "boolean" },
        "gaps":                { "type": "array", "items": { "type": "string" } },
        "limitations":         { "type": "array", "items": { "type": "string" } },
        "required_analyzers":  { "type": "array", "items": { "type": "string" } },
        "required_gaps":       { "type": "array", "items": { "type": "string" } },
        "retried":             { "type": "array", "items": { "type": "string" } },
        "active_probes":       { "$ref": "#/definitions/ActiveProbeCoverage" }
      }
    },
    "ActiveProbeCoverage": {
      "type": "object",
      "description": "Present when active probing was enabled. Accounts for every active probe sent. A scan-wide configured_complete is never proof that every probe was evaluated: read this beside it. attempted = evaluated + inconclusive + unknown_origin + scanner_failed.",
      "required": ["attempted", "evaluated", "inconclusive", "unknown_origin", "scanner_failed", "reasons", "not_evaluated_checks", "truncated"],
      "additionalProperties": false,
      "properties": {
        "attempted":      { "type": "integer", "minimum": 0 },
        "evaluated":      { "type": "integer", "minimum": 0, "description": "A response came back and the check judged it." },
        "inconclusive":   { "type": "integer", "minimum": 0, "description": "Confirmed target-side non-answer: not an evaluation, never evidence that anything is absent, safe or fixed, and not a scanner gap." },
        "unknown_origin": { "type": "integer", "minimum": 0, "description": "No evidence settles whose fault the failure is. Fail-closed: not evaluated, and a coverage gap for active-probes." },
        "scanner_failed": { "type": "integer", "minimum": 0, "description": "The engine failed or never sent the probe. Not evaluated, and a coverage gap for active-probes." },
        "reasons": {
          "type": "object",
          "description": "{origin: {reason: count}}. Origins: target, unknown, scanner. Reasons are a closed vocabulary per origin.",
          "additionalProperties": false,
          "properties": {
            "target":  { "type": "object", "additionalProperties": false, "properties": {
              "timeout": { "type": "integer", "minimum": 1 }, "connection_reset": { "type": "integer", "minimum": 1 }, "connection_refused": { "type": "integer", "minimum": 1 },
              "tls_error": { "type": "integer", "minimum": 1 }, "rate_limited": { "type": "integer", "minimum": 1 }, "service_unavailable": { "type": "integer", "minimum": 1 },
              "other_transport": { "type": "integer", "minimum": 1 } } },
            "unknown": { "type": "object", "additionalProperties": false, "properties": {
              "dns_failure": { "type": "integer", "minimum": 1 }, "timeout": { "type": "integer", "minimum": 1 }, "connection_refused": { "type": "integer", "minimum": 1 },
              "network_unreachable": { "type": "integer", "minimum": 1 }, "tls_handshake": { "type": "integer", "minimum": 1 }, "unclassified": { "type": "integer", "minimum": 1 } } },
            "scanner": { "type": "object", "additionalProperties": false, "properties": {
              "internal_error": { "type": "integer", "minimum": 1 }, "scan_deadline": { "type": "integer", "minimum": 1 }, "scan_cancelled": { "type": "integer", "minimum": 1 },
              "resource_exhausted": { "type": "integer", "minimum": 1 }, "proxy_failure": { "type": "integer", "minimum": 1 }, "request_construction": { "type": "integer", "minimum": 1 },
              "not_sent": { "type": "integer", "minimum": 1 } } }
          }
        },
        "not_evaluated_checks": {
          "type": "array",
          "maxItems": 200,
          "description": "Distinct (check, endpoint, origin, reason) with a probe that was not evaluated, scanner then unknown then target. A (check, endpoint) pair absent from the list was evaluated only when truncated is false.",
          "items": { "$ref": "#/definitions/NotEvaluatedCheck" }
        },
        "truncated": { "type": "boolean", "description": "not_evaluated_checks was cut at 200 entries." }
      }
    },
    "NotEvaluatedCheck": {
      "type": "object",
      "required": ["check", "endpoint", "origin", "reason", "evidence"],
      "additionalProperties": false,
      "properties": {
        "check":    { "type": "string", "description": "The rule-id family of the findings the probe could produce: injection, xss, ssrf, openredirect, hostheader, graphql, methodtamper." },
        "endpoint": { "type": "string", "description": "METHOD /path, exactly as a finding names its endpoint." },
        "origin":   { "type": "string", "enum": ["target", "unknown", "scanner"] },
        "reason":   { "type": "string" },
        "evidence": { "type": "string", "description": "A fixed phrase stating what was observed." }
      }
    },
    "SeverityCounts": {
      "type": "object",
      "required": ["critical", "high", "medium", "low", "info"],
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high":     { "type": "integer", "minimum": 0 },
        "medium":   { "type": "integer", "minimum": 0 },
        "low":      { "type": "integer", "minimum": 0 },
        "info":     { "type": "integer", "minimum": 0 }
      }
    },
    "SourceCounts": {
      "type": "object",
      "required": ["blackbox", "whitebox", "correlated"],
      "additionalProperties": false,
      "properties": {
        "blackbox":   { "type": "integer", "minimum": 0 },
        "whitebox":   { "type": "integer", "minimum": 0 },
        "correlated": { "type": "integer", "minimum": 0 }
      }
    },
    "StatusCounts": {
      "description": "v0.24 decision summary. Additive; not in the root `required` set.",
      "type": "object",
      "required": ["total", "confirmed", "blocking", "warning", "informational"],
      "additionalProperties": false,
      "properties": {
        "total":         { "type": "integer", "minimum": 0 },
        "confirmed":     { "type": "integer", "minimum": 0 },
        "blocking":      { "type": "integer", "minimum": 0 },
        "warning":       { "type": "integer", "minimum": 0 },
        "informational": { "type": "integer", "minimum": 0 }
      }
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method":  { "type": "string" },
        "pattern": { "type": "string" },
        "handler": { "type": "string" },
        "file":    { "type": "string" },
        "line":    { "type": "integer", "minimum": 0 }
      }
    },
    "ImportedTool": {
      "type": "object",
      "required": ["tool", "results"],
      "additionalProperties": false,
      "properties": {
        "tool":         { "type": "string" },
        "version":      { "type": "string" },
        "results":      { "type": "integer", "minimum": 0 },
        "suppressed":   { "type": "integer", "minimum": 0 },
        "no_location":  { "type": "integer", "minimum": 0 },
        "corroborated": { "type": "integer", "minimum": 0 }
      }
    },
    "ConfidenceReason": {
      "type": "object",
      "description": "One scoring rule's contribution to a confidence score. `code` is the stable machine-readable identity a consumer matches on; `text` is human wording and is free to be reworded. The `delta` values of a finding's confidence_breakdown sum to its confidence_score.",
      "additionalProperties": false,
      "required": ["delta", "code", "text"],
      "properties": {
        "delta": { "type": "integer" },
        "code":  { "type": "string" },
        "text":  { "type": "string" }
      }
    },
    "DependencyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ecosystem": { "type": "string" },
        "package":   { "type": "string" },
        "version":   { "type": "string" },
        "manifest":  { "type": "string" }
      }
    },
    "SecretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": { "type": "string" },
        "file":       { "type": "string" }
      }
    },
    "Occurrence": {
      "type": "object",
      "description": "One security occurrence: where it is, and its own fendix/v2 fingerprint, computed from that occurrence alone before any grouping.",
      "required": ["endpoint", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "endpoint":    { "type": "string" },
        "fingerprint": { "type": "string" }
      }
    },
    "TaintLink": {
      "type": "object",
      "required": ["file", "line", "expr"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "expr": { "type": "string" }
      }
    },
    "Finding": {
      "type": "object",
      "required": ["id", "title", "severity", "source", "category", "endpoint", "evidence", "fix", "references", "confidence", "line"],
      "additionalProperties": false,
      "properties": {
        "id":                 { "type": "string", "pattern": "^SEC-[0-9]+$" },
        "title":              { "type": "string", "minLength": 1 },
        "severity":           { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
        "source":             { "type": "string", "enum": ["blackbox", "whitebox", "correlated", "imported"] },
        "category":           { "type": "string", "minLength": 1 },
        "endpoint":           { "type": "string" },
        "affected_endpoints": { "type": "array", "items": { "type": "string" } },
        "occurrences":        { "type": "array", "items": { "$ref": "#/definitions/Occurrence" }, "description": "Every distinct security occurrence this finding presents, one per (endpoint, occurrence fingerprint). Identity, .fendix-ignore matching, baseline matching and lifecycle tracking act on occurrences; the finding is a presentation group. The finding's own fingerprint is its primary occurrence's and always appears here. Absent on reports from engines that predate the field." },
        "evidence":           { "type": "string" },
        "fix":                { "type": "string" },
        "references":         { "type": "array", "items": { "type": "string" } },
        "confidence":         { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "line":               { "type": ["string", "null"] },
        "taint_chain":        { "type": "array", "items": { "$ref": "#/definitions/TaintLink" } },
        "reachable":          { "type": "boolean" },
        "fingerprint":        { "type": "string" },
        "fingerprint_v1":     { "type": "string" },
        "source_tier":        { "type": "string", "enum": ["native_go", "tree_sitter_sidecar", "semgrep_shim", "semgrep_taint"] },
        "route":              { "$ref": "#/definitions/Route" },
        "route_confirmed":    { "type": "boolean" },
        "proven_path":        { "type": "boolean" },
        "status":             { "type": "string", "enum": ["BLOCK", "WARN", "INFO"] },
        "confidence_score":   { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence_band":    { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "confidence_reasons": { "type": "array", "items": { "type": "string" } },
        "confidence_breakdown": { "type": "array", "items": { "$ref": "#/definitions/ConfidenceReason" } },
        "rule_id":            { "type": "string" },
        "dependency":         { "$ref": "#/definitions/DependencyRef" },
        "secret":             { "$ref": "#/definitions/SecretRef" },
        "sink":               { "type": "string" },
        "symbol":             { "type": "string" },
        "decision_reason":       { "type": "string" },
        "decision_policy":       { "type": "string", "enum": ["enforced", "relaxed"] },
        "policy_override":       { "type": "boolean" },
        "independent_signals":   { "type": "array", "items": { "type": "string" } },
        "self_evident_signals":  { "type": "array", "items": { "type": "string" } },
        "auth_expectation":      { "type": "string", "enum": ["public", "required"] },
        "applicability":         { "type": "string", "enum": ["applicable", "evidence_against"] },
        "cross_tool_corroborated": { "type": "boolean" },
        "corroborating_tools":     { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "description": "Severity-confidence consistency: LOW confidence caps severity at MEDIUM.",
          "if":   { "properties": { "confidence": { "const": "LOW" } } },
          "then": { "properties": { "severity":   { "enum": ["MEDIUM", "LOW", "INFO"] } } }
        }
      ]
    }
  }
}
