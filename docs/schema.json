{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Fendix-app/Fendix/blob/main/docs/schema.json",
  "title": "FendixJSONReport",
  "description": "Schema for Fendix scan output produced by `fendix scan --format json`. Stable for the 1.x line: additive within 1.x, removals and type changes reserved for 2.0.0. Reports from the (end-of-life) 0.x line also validate, since every 0.x change was additive. See docs/schema.md.",
  "type": "object",
  "required": ["metadata", "summary", "sources", "total", "findings"],
  "additionalProperties": false,
  "properties": {
    "metadata": { "$ref": "#/definitions/ScanMetadata" },
    "summary":  { "$ref": "#/definitions/SeverityCounts" },
    "sources":  { "$ref": "#/definitions/SourceCounts" },
    "total":    { "type": "integer", "minimum": 0 },
    "decisions": { "$ref": "#/definitions/StatusCounts" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/Finding" }
    }
  },
  "definitions": {
    "ScanMetadata": {
      "type": "object",
      "required": ["target", "started_at", "duration", "version", "mode", "endpoints_scanned", "active_probes"],
      "additionalProperties": false,
      "properties": {
        "schema_version":    { "type": "integer", "minimum": 1 },
        "fingerprint_algorithm": { "type": "string" },
        "imports":           { "type": "array", "items": { "$ref": "#/definitions/ImportedTool" } },
        "target":            { "type": "string" },
        "started_at":        { "type": "string", "format": "date-time" },
        "duration":          { "type": "string" },
        "version":           { "type": "string" },
        "mode":              { "type": "string", "enum": ["blackbox", "whitebox", "hybrid", "import"] },
        "endpoints_scanned": { "type": "integer", "minimum": 0 },
        "endpoints_discovered": { "type": "integer", "minimum": 0 },
        "endpoints_truncated":  { "type": "boolean" },
        "active_probes":     { "type": "boolean" },
        "checks_run":        { "type": "array", "items": { "type": "string" } },
        "scanner_status":    { "type": "array", "items": { "$ref": "#/definitions/ScannerStatus" } },
        "coverage":          { "$ref": "#/definitions/Coverage" },
        "policy_version":    { "type": "string" },
        "release_decision":  { "type": "string", "enum": ["pass", "warn", "block", "incomplete"] },
        "coverage_state":    { "type": "string", "enum": ["complete", "incomplete", "unknown"] },
        "decision_policy_version": { "type": "string" },
        "decision_rationale": { "type": "object" }
      }
    },
    "ScannerStatus": {
      "type": "object",
      "required": ["name", "state"],
      "additionalProperties": false,
      "properties": {
        "name":     { "type": "string" },
        "state":    { "type": "string", "enum": ["ok", "skipped", "failed"] },
        "reason":   { "type": "string", "enum": ["not_applicable", "diff_unchanged", "disabled_by_flag", "disabled_offline", "dependency_missing", "unsupported_target", "network_error", "timeout", "execution_error", "malformed_output", "truncated_output", "input_error", "no_endpoints"] },
        "detail":   { "type": "string" },
        "attempts": { "type": "integer", "minimum": 2 }
      }
    },
    "Coverage": {
      "type": "object",
      "required": ["contract_version", "strict", "configured_complete", "gaps", "limitations", "required_analyzers", "required_gaps", "retried"],
      "additionalProperties": false,
      "properties": {
        "contract_version":    { "type": "integer", "minimum": 1 },
        "strict":              { "type": "boolean" },
        "configured_complete": { "type": "boolean" },
        "gaps":                { "type": "array", "items": { "type": "string" } },
        "limitations":         { "type": "array", "items": { "type": "string" } },
        "required_analyzers":  { "type": "array", "items": { "type": "string" } },
        "required_gaps":       { "type": "array", "items": { "type": "string" } },
        "retried":             { "type": "array", "items": { "type": "string" } }
      }
    },
    "SeverityCounts": {
      "type": "object",
      "required": ["critical", "high", "medium", "low", "info"],
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high":     { "type": "integer", "minimum": 0 },
        "medium":   { "type": "integer", "minimum": 0 },
        "low":      { "type": "integer", "minimum": 0 },
        "info":     { "type": "integer", "minimum": 0 }
      }
    },
    "SourceCounts": {
      "type": "object",
      "required": ["blackbox", "whitebox", "correlated"],
      "additionalProperties": false,
      "properties": {
        "blackbox":   { "type": "integer", "minimum": 0 },
        "whitebox":   { "type": "integer", "minimum": 0 },
        "correlated": { "type": "integer", "minimum": 0 }
      }
    },
    "StatusCounts": {
      "description": "v0.24 decision summary. Additive; not in the root `required` set.",
      "type": "object",
      "required": ["total", "confirmed", "blocking", "warning", "informational"],
      "additionalProperties": false,
      "properties": {
        "total":         { "type": "integer", "minimum": 0 },
        "confirmed":     { "type": "integer", "minimum": 0 },
        "blocking":      { "type": "integer", "minimum": 0 },
        "warning":       { "type": "integer", "minimum": 0 },
        "informational": { "type": "integer", "minimum": 0 }
      }
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method":  { "type": "string" },
        "pattern": { "type": "string" },
        "handler": { "type": "string" },
        "file":    { "type": "string" },
        "line":    { "type": "integer", "minimum": 0 }
      }
    },
    "ImportedTool": {
      "type": "object",
      "required": ["tool", "results"],
      "additionalProperties": false,
      "properties": {
        "tool":         { "type": "string" },
        "version":      { "type": "string" },
        "results":      { "type": "integer", "minimum": 0 },
        "suppressed":   { "type": "integer", "minimum": 0 },
        "no_location":  { "type": "integer", "minimum": 0 },
        "corroborated": { "type": "integer", "minimum": 0 }
      }
    },
    "ConfidenceReason": {
      "type": "object",
      "description": "One scoring rule's contribution to a confidence score. `code` is the stable machine-readable identity a consumer matches on; `text` is human wording and is free to be reworded. The `delta` values of a finding's confidence_breakdown sum to its confidence_score.",
      "additionalProperties": false,
      "required": ["delta", "code", "text"],
      "properties": {
        "delta": { "type": "integer" },
        "code":  { "type": "string" },
        "text":  { "type": "string" }
      }
    },
    "DependencyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ecosystem": { "type": "string" },
        "package":   { "type": "string" },
        "version":   { "type": "string" },
        "manifest":  { "type": "string" }
      }
    },
    "SecretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": { "type": "string" },
        "file":       { "type": "string" }
      }
    },
    "TaintLink": {
      "type": "object",
      "required": ["file", "line", "expr"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "expr": { "type": "string" }
      }
    },
    "Finding": {
      "type": "object",
      "required": ["id", "title", "severity", "source", "category", "endpoint", "evidence", "fix", "references", "confidence", "line"],
      "additionalProperties": false,
      "properties": {
        "id":                 { "type": "string", "pattern": "^SEC-[0-9]+$" },
        "title":              { "type": "string", "minLength": 1 },
        "severity":           { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
        "source":             { "type": "string", "enum": ["blackbox", "whitebox", "correlated"] },
        "category":           { "type": "string", "minLength": 1 },
        "endpoint":           { "type": "string" },
        "affected_endpoints": { "type": "array", "items": { "type": "string" } },
        "evidence":           { "type": "string" },
        "fix":                { "type": "string" },
        "references":         { "type": "array", "items": { "type": "string" } },
        "confidence":         { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "line":               { "type": ["string", "null"] },
        "taint_chain":        { "type": "array", "items": { "$ref": "#/definitions/TaintLink" } },
        "reachable":          { "type": "boolean" },
        "fingerprint":        { "type": "string" },
        "fingerprint_v1":     { "type": "string" },
        "source_tier":        { "type": "string", "enum": ["native_go", "tree_sitter_sidecar", "semgrep_shim"] },
        "route":              { "$ref": "#/definitions/Route" },
        "route_confirmed":    { "type": "boolean" },
        "proven_path":        { "type": "boolean" },
        "status":             { "type": "string", "enum": ["BLOCK", "WARN", "INFO"] },
        "confidence_score":   { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence_band":    { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "confidence_reasons": { "type": "array", "items": { "type": "string" } },
        "confidence_breakdown": { "type": "array", "items": { "$ref": "#/definitions/ConfidenceReason" } },
        "rule_id":            { "type": "string" },
        "dependency":         { "$ref": "#/definitions/DependencyRef" },
        "secret":             { "$ref": "#/definitions/SecretRef" },
        "sink":               { "type": "string" },
        "symbol":             { "type": "string" },
        "decision_reason":       { "type": "string" },
        "decision_policy":       { "type": "string", "enum": ["enforced", "relaxed"] },
        "policy_override":       { "type": "boolean" },
        "independent_signals":   { "type": "array", "items": { "type": "string" } },
        "self_evident_signals":  { "type": "array", "items": { "type": "string" } },
        "auth_expectation":      { "type": "string", "enum": ["public", "required"] },
        "applicability":         { "type": "string", "enum": ["applicable", "evidence_against"] },
        "cross_tool_corroborated": { "type": "boolean" },
        "corroborating_tools":     { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "description": "Severity-confidence consistency: LOW confidence caps severity at MEDIUM.",
          "if":   { "properties": { "confidence": { "const": "LOW" } } },
          "then": { "properties": { "severity":   { "enum": ["MEDIUM", "LOW", "INFO"] } } }
        }
      ]
    }
  }
}
