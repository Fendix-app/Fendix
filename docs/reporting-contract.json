    "sarif_export": {
      "version": "2.1.0",
      "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
      "runs": [
        {
          "tool": {
            "driver": {
              "name": "Fendix",
              "version": "v3.5.1",
              "informationUri": "https://github.com/Fendix-app/Fendix",
              "rules": [
                {
                  "id": "fendix.auth.python-auth-missing",
                  "name": "Missing authentication on user data endpoint",
                  "shortDescription": {
                    "text": "Missing authentication on user data endpoint"
                  },
                  "help": {
                    "text": "Require authentication before returning user data."
                  },
