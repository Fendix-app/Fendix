{
  "$id": "https://schemas.fendix.dev/managed-ci/v1/evidence-submission-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "$ref": "https://schemas.fendix.dev/managed-ci/v1/common.schema.json#/$defs/api_version"
    },
    "evidence_submission_id": {
      "$ref": "https://schemas.fendix.dev/managed-ci/v1/common.schema.json#/$defs/uuid"
    },
    "idempotency_key": {
      "maxLength": 512,
      "minLength": 16,
      "pattern": "^github:[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*:[0-9a-f]{40}$",
      "type": "string"
    },
    "manifest": {
      "$ref": "https://schemas.fendix.dev/managed-ci/v1/evidence-manifest.schema.json"
    }
  },
  "required": [
    "api_version",
    "evidence_submission_id",
    "idempotency_key",
    "manifest"
  ],
  "title": "Evidence submission request",
  "type": "object"
}
