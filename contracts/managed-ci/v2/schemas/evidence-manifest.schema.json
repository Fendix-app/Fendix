{
  "$id": "https://schemas.fendix.dev/managed-ci/v2/evidence-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analyzers": {
      "items": {
        "$ref": "https://schemas.fendix.dev/managed-ci/v2/analyzer-execution-result.schema.json"
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
    },
    "artifact_hash": {
      "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/sha256"
    },
    "configuration_hash": {
      "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/sha256"
    },
    "context": {
      "$ref": "https://schemas.fendix.dev/managed-ci/v2/managed-scan-context.schema.json"
    },
    "coverage": {
      "$ref": "https://schemas.fendix.dev/managed-ci/v2/coverage-state.schema.json"
    },
    "engine": {
      "additionalProperties": false,
      "properties": {
        "build_digest": {
          "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/sha256"
        },
        "finding_policy_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string",
          "description": "Finding-policy specification the evidence_facts were produced for. A version the backend does not support is rejected with unsupported_version."
        },
        "report_schema_version": {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "version": {
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "type": "string"
        }
      },
      "required": [
        "version",
        "build_digest",
        "report_schema_version",
        "finding_policy_version"
      ],
      "type": "object"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "analyzer_id": {
            "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/identifier",
            "description": "The manifest analyzer that produced this finding. Must name an entry of `analyzers`; each analyzer's finding_count equals the number of findings naming it."
          },
          "category": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "evidence_facts": {
            "$ref": "https://schemas.fendix.dev/managed-ci/v2/evidence-facts.schema.json"
          },
          "evidence_hashes": {
            "items": {
              "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/sha256"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "finding_id": {
            "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/identifier"
          },
          "fingerprint": {
            "description": "The producer's stable finding identity. Hex, either 40 or 64 characters: a producer may truncate its digest to stay the width of an identity it replaces, and the backend compares fingerprints, never re-derives them.",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
            "type": "string"
          },
          "locations": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "end_line": {
                  "maximum": 100000000,
                  "minimum": 1,
                  "type": "integer"
                },
                "path": {
                  "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/relative_path"
                },
                "start_line": {
                  "maximum": 100000000,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": ["path"],
              "type": "object"
            },
            "maxItems": 20,
            "type": "array"
          },
          "package": {
            "additionalProperties": false,
            "properties": {
              "advisory_ids": {
                "items": {
                  "maxLength": 128,
                  "type": "string"
                },
                "maxItems": 50,
                "type": "array",
                "uniqueItems": true
              },
              "ecosystem": {
                "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/identifier"
              },
              "name": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["ecosystem", "name", "version"],
            "type": "object"
          },
          "rule_id": {
            "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/identifier"
          },
          "severity": {
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"],
            "description": "The finding's normalized severity after the engine's severity-consistency cap. Must not exceed the cap implied by evidence_facts.rule_precision."
          },
          "signals": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/identifier"
                },
                "value": {
                  "oneOf": [
                    {
                      "maxLength": 512,
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "required": ["kind", "value"],
              "type": "object"
            },
            "maxItems": 50,
            "type": "array",
            "description": "Bounded, non-authoritative context for display. Never an input to classification; classification reads evidence_facts only."
          }
        },
        "required": [
          "finding_id",
          "fingerprint",
          "rule_id",
          "analyzer_id",
          "severity",
          "category",
          "evidence_hashes",
          "evidence_facts"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "generated_at": {
      "$ref": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json#/$defs/timestamp"
    },
    "producer_diagnostics": {
      "additionalProperties": false,
      "description": "Untrusted diagnostics. Authoritative evaluation MUST ignore this object.",
      "properties": {
        "local_confidence_label": {
          "maxLength": 64,
          "type": "string"
        },
        "local_exit_code": {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "local_verdict": {
          "enum": ["PASS", "INFO", "WARN", "BLOCK", "INCOMPLETE"]
        }
      },
      "type": "object"
    },
    "sanitization": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "managed-ci-default/v1"
        },
        "redaction_count": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "source_excerpts_included": {
          "const": false
        }
      },
      "required": ["profile", "source_excerpts_included", "redaction_count"],
      "type": "object"
    },
    "schema_version": {
      "const": "evidence-manifest/v2"
    }
  },
  "required": [
    "schema_version",
    "context",
    "engine",
    "configuration_hash",
    "artifact_hash",
    "generated_at",
    "analyzers",
    "coverage",
    "findings",
    "sanitization"
  ],
  "title": "Sanitized evidence manifest",
  "type": "object"
}
