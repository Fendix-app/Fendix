{
  "$defs": {
    "api_version": {
      "const": "managed-ci/v2"
    },
    "bounded_text": {
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$",
      "type": "string"
    },
    "decision": {
      "enum": ["PASS", "INFO", "WARN", "BLOCK", "INCOMPLETE"]
    },
    "git_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
      "type": "string"
    },
    "relative_path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\r\\n]+$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "state": {
      "enum": [
        "accepted",
        "validating",
        "evaluating",
        "completed",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "uuid": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.fendix.dev/managed-ci/v2/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fendix managed CI common types",
  "type": "object"
}
